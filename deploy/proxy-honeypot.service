[Unit]
Description=Proxy Auth Honeypot (SOCKS5/HTTP credential trap)
Documentation=https://github.com/example/proxy-auth-honeypot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=honeypot
Group=honeypot
WorkingDirectory=/opt/proxy-honeypot
EnvironmentFile=-/opt/proxy-honeypot/.env
# Prefer venv interpreter after: python -m venv .venv && pip install -e .
ExecStart=/opt/proxy-honeypot/.venv/bin/python -m honeypot run
Restart=always
RestartSec=3
# Plenty of FDs for multi-port scanners
LimitNOFILE=65535
# Optional hardening
NoNewPrivileges=true
PrivateTmp=true
# Do not grant raw network capability unless you bind ports <1024
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=proxy-honeypot

[Install]
WantedBy=multi-user.target
