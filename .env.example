# Copy to .env or export in shell. Never commit real secrets.

DATA_DIR=./data
CONFIG_PATH=./config/config.example.yaml
HONEYPOT_BIND=0.0.0.0
# always_fail (default L1) | accept_then_fail (L2: auth ok then CONNECT fails, still no forward)
AUTH_MODE=always_fail

# Connection limits
MAX_CONNS_GLOBAL=5000
MAX_CONNS_PER_IP=50
READ_TIMEOUT_SEC=10
QUEUE_MAXSIZE=10000

# Phase 3 retention / ops (0 disables)
EVENTS_RETENTION_DAYS=90
JSONL_RETENTION_DAYS=180
AUTH_STALE_WARN_HOURS=24
AUTO_EXPORT_HOURS=24
MAINTENANCE_INTERVAL_SEC=3600

# Web (optional but recommended for ops)
WEB_ENABLED=true
# Prefer 127.0.0.1 on public VPS; use SSH tunnel or reverse proxy
WEB_BIND=0.0.0.0:8787
WEB_AUTH_USER=admin
WEB_PASSWORD=change-me-to-a-long-random-string
WEB_SESSION_SECRET=change-me-to-another-long-random-string
WEB_LOGIN_MAX_FAILURES=5
WEB_LOGIN_BAN_MINUTES=15

LOG_LEVEL=info
