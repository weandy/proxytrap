# Minimal runtime env. AI endpoint/key/model are saved in Web UI → DATA_DIR/ai_settings.json

# Data & ports config
DATA_DIR=./data
CONFIG_PATH=./config/config.example.yaml
HONEYPOT_BIND=0.0.0.0

# Web admin (required when WEB_ENABLED=true)
WEB_ENABLED=true
WEB_BIND=127.0.0.1:8787
WEB_AUTH_USER=admin
WEB_PASSWORD=change-me-to-a-long-random-string
WEB_SESSION_SECRET=change-me-to-another-long-random-string

# Optional overrides (have sensible defaults)
# AUTH_MODE=always_fail
# LOG_LEVEL=info
# MAX_CONNS_GLOBAL=5000
# MAX_CONNS_PER_IP=50
# EVENTS_RETENTION_DAYS=90
# JSONL_RETENTION_DAYS=180
